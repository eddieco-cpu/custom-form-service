# Copy this file to .env and replace the password before local use.
PostgreSql__Host=localhost
PostgreSql__Port=5432
PostgreSql__Database=custom_form_service
PostgreSql__Username=custom_form_service
PostgreSql__Password=replace-with-a-local-password
Jwt__SigningKey=replace-with-at-least-32-random-characters
Jwt__LifetimeMinutes=1440
Cors__AllowedOrigins__0=http://localhost:3000
