POST {{apiBase}}/api/v1/forms/{{mainFormId}}/responses HTTP/1.1
Cookie: access_token={{bToken}}
Content-Type: application/json

{
  "answers": [
    {
      "questionId": "{{qRating}}",
      "value": 0
    },
    {
      "questionId": "{{qMultiple}}",
      "value": [
        "{{mOne}}"
      ]
    },
    {
      "questionId": "{{qSingle}}",
      "value": "{{sNo}}"
    },
    {
      "questionId": "{{qNumber}}",
      "value": 1.0
    }
  ]
}

