# R11 — Prepare；計畫待 Owner review。49 HTTP／6非HTTP；全部AI／人工未執行（等待 Owner review）。
# Companion: R11_Acceptance_Test.md，依01→02→03→04→05～13→14→15。
# 不使用 Send All；Owner 核准目前paired files及明確Execute授權後才執行。
# 非HTTP 01 baseline／02 clean snapshot build／03隔離空DB migration／04full及兩native PID，詳Markdown §3。
# 固定開發volume名稱不能只靠-p隔離；03必須override volume name並inspect真正Mounts。
# 只用本次原生DLL；05a/b空庫、05c/d既有開發DB；所有業務HTTP用apiBase。
# Clear All Cookies；每request @no-cookie-jar；只有明確Cookie。工作副本／記憶體存憑證，交付恢復placeholder。
# JSON body／IDs／token不可沿用歷史Run；number1.0直接發raw JSON。
# 每案前置／預期及分開結果在Markdown；14核對完整列／GET無寫入，保留fixtures／隔離volume；15交接。
# G1 pending；不開始前端或部署。

@runId = <NEW_UNIQUE_R11_RUN_ID_AFTER_APPROVAL>
@apiBase = http://localhost:5012
@emptyApiBase = http://localhost:5013
@testPassword = <GENERATE_SYNTHETIC_PASSWORD_LOCALLY>
@aToken = <ACCESS_TOKEN_VALUE_FROM_06d_LOCALLY>
@bToken = <ACCESS_TOKEN_VALUE_FROM_06e_LOCALLY>
@mainFormId = <M_ID_FROM_07a>
@singleFormId = <S_ID_FROM_11a>
@qText = <TEXT_ID_FROM_07b>
@qNumber = <NUMBER_ID_FROM_07b>
@qSingle = <SINGLE_CHOICE_ID_FROM_07b>
@qMultiple = <MULTIPLE_CHOICE_ID_FROM_07b>
@qRating = <RATING_ID_FROM_07b>
@sYes = <YES_OPTION_ID_FROM_07b>
@sNo = <NO_OPTION_ID_FROM_07b>
@mOne = <ONE_OPTION_ID_FROM_07b>
@mTwo = <TWO_OPTION_ID_FROM_07b>
@qIdentified = <TEXT_ID_FROM_11a>

###
# 05a — 隔離空庫 API health
# 前置：03 migration、04 full 與本次隔離 API 啟動完成
# 預期：200；{"status":"healthy"}
# @no-cookie-jar
GET {{emptyApiBase}}/health HTTP/1.1

###
# 05b — 隔離空庫 API readiness
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：200；Healthy；實際連線隔離 DB
# @no-cookie-jar
GET {{emptyApiBase}}/health/ready HTTP/1.1

###
# 05c — 開發 DB API health
# 前置：04 後啟動另一個本次 DLL PID，連既有開發 DB
# 預期：200；{"status":"healthy"}
# @no-cookie-jar
GET {{apiBase}}/health HTTP/1.1

###
# 05d — 開發 DB API readiness
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：200；Healthy；記錄 PID／port／DB 對應
# @no-cookie-jar
GET {{apiBase}}/health/ready HTTP/1.1

###
# 06a — 註冊 A
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：201 User；A id；無 access_token Cookie
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "r11-a-{{runId}}@example.test",
  "password": "{{testPassword}}",
  "displayName": "R11 A"
}

###
# 06b — 註冊 B
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：201 User；B id；無 access_token Cookie
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "r11-b-{{runId}}@example.test",
  "password": "{{testPassword}}",
  "displayName": "R11 B"
}

###
# 06c — 註冊不自動登入
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：401 AUTH_REQUIRED；Error Envelope
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1

###
# 06d — 登入 A
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：200 User.id=A；Set-Cookie flags／expiry 依 §2；保存 aToken 於記憶體
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "r11-a-{{runId}}@example.test",
  "password": "{{testPassword}}"
}

###
# 06e — 登入 B
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：200 User.id=B；同 Cookie 契約；保存 bToken 於記憶體
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "r11-b-{{runId}}@example.test",
  "password": "{{testPassword}}"
}

###
# 06f — 確認本人 B
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：200 User.id=B；只四欄 User
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1
Cookie: access_token={{bToken}}

###
# 07a — 建立空草稿 M
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：201 Draft；title trim；questions=[]；multiple／anonymous／owner_only；保存 mainFormId
# @no-cookie-jar
POST {{apiBase}}/api/v1/forms HTTP/1.1
Cookie: access_token={{aToken}}
Content-Type: application/json

{
  "title": " R11 main {{runId}} ",
  "responseMode": "multiple",
  "responseIdentity": "anonymous"
}

###
# 07b — 編輯五題型草稿
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：200 完整 FormDetail；title 已編輯、description=null；排序10..50、Options10/20；按 type／Option.value保存IDs
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/forms/{{mainFormId}} HTTP/1.1
Cookie: access_token={{aToken}}
Content-Type: application/json

{
  "title": "R11 main edited {{runId}}",
  "description": " ",
  "questions": [
    {
      "type": "rating",
      "title": "Rating",
      "sortOrder": 50,
      "config": {
        "min": 0,
        "max": 2
      }
    },
    {
      "type": "multiple_choice",
      "title": "Multiple",
      "sortOrder": 40,
      "options": [
        {
          "label": "Two",
          "value": "two",
          "sortOrder": 20
        },
        {
          "label": "One",
          "value": "one",
          "sortOrder": 10
        }
      ]
    },
    {
      "type": "single_choice",
      "title": "Single",
      "sortOrder": 30,
      "options": [
        {
          "label": "No",
          "value": "no",
          "sortOrder": 20
        },
        {
          "label": "Yes",
          "value": "yes",
          "sortOrder": 10
        }
      ]
    },
    {
      "type": "number",
      "title": "Number",
      "sortOrder": 20
    },
    {
      "type": "text",
      "title": "Text",
      "sortOrder": 10
    }
  ]
}

###
# 07c — 他人草稿存在性隱藏
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：404 FORM_NOT_FOUND
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms/{{mainFormId}} HTTP/1.1
Cookie: access_token={{bToken}}

###
# 07d — 拒絕無效 Delta 並保證原子性
# 前置：前案達到預期後順序執行；細節見 Markdown 同編號
# 預期：400 FORM_DEFINITION_INVALID；detail questions[0].sortOrder／INVALID_SORT_ORDER；title／全部列與 timestamps 不變
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/forms/{{mainFormId}} HTTP/1.1
Cookie: access_token={{aToken}}
Content-Type: application/json

{
  "title": "Must not persist",
  "questions": [
    {
      "id": "{{qText}}",
      "sortOrder": -1
    }
  ]
}

