# R4 manual requests for the VS Code REST Client extension.
# The Markdown plan (R4_Acceptance_Test.md) is the test authority; this file is its request companion.
# Before a run, complete Markdown test 1 (Compose, build, standard API start, and readiness).
# Use one fixed runId for the whole run. To register again, change only runId to a new unique value;
# member emails below then change together. Keep the two synthetic members after the run.
#
# Cookie handling: before running requests, run "Rest Client: Clear All Cookies". Every request below
# uses @no-cookie-jar, so cookies are neither saved nor replayed automatically. After a login response,
# manually copy only the value after "access_token=" and before its first semicolon into the matching
# token variable. Do not copy the full Set-Cookie header or any attributes into a Cookie header.
# Requests that intentionally have no Cookie, an invalid Cookie, or an expired Cookie therefore cannot
# be affected by a client cookie jar.

@apiBase = http://localhost:5000
@shortApiBase = http://localhost:5001
@allowedOrigin = http://localhost:3000
@runId = r4-acceptance-20261001-01
@testPassword = R4 local password {{runId}}!
@memberAEmail = r4-member-a-{{runId}}@example.test
@memberAEmailUpper = R4-MEMBER-A-R4-ACCEPTANCE-20261001-01@EXAMPLE.TEST
@memberBEmail = r4-member-b-{{runId}}@example.test
@unknownEmail = r4-unknown-{{runId}}@example.test
@memberAToken = PASTE_ACCESS_TOKEN_VALUE_ONLY
@memberBToken = PASTE_ACCESS_TOKEN_VALUE_ONLY
@shortToken = PASTE_ACCESS_TOKEN_VALUE_ONLY

###
# Test 1 — health. Prerequisite: standard API has started on {{apiBase}}.
# Expected: 200 and {"status":"healthy"}.
# @no-cookie-jar
GET {{apiBase}}/health HTTP/1.1

###
# Test 1 — PostgreSQL readiness. Prerequisite: Compose postgres is healthy.
# Expected: 200 and Healthy.
# @no-cookie-jar
GET {{apiBase}}/health/ready HTTP/1.1

###
# Test 2 — register Member A. Prerequisite: use this runId only once for registration.
# Expected: 201; public User body; no access_token Set-Cookie.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}",
  "password": "{{testPassword}}",
  "displayName": "R4 Member A"
}

###
# Test 2 — register Member B. Prerequisite: Member A registration succeeded.
# Expected: 201; public User body; no access_token Set-Cookie.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberBEmail}}",
  "password": "{{testPassword}}",
  "displayName": "R4 Member B"
}

###
# Test 3 — no-cookie current user. Prerequisite: Member A has registered but has not logged in.
# Expected: 401 AUTH_REQUIRED. Leave out the Cookie header.
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1

###
# Test 3 — login Member A. Copy only access_token's value into @memberAToken after this response.
# Expected: 200; public User body and a Set-Cookie header.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 3 — current user with the manually copied Member A token.
# Prerequisite: @memberAToken contains only the access_token value from the preceding login.
# Expected: 200; email is {{memberAEmail}}.
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 3 — update Member A displayName with the same explicit Cookie header.
# Expected: 200; displayName is R4 Member A Updated.
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/users/me HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{
  "displayName": "R4 Member A Updated"
}

###
# Test 3 — read updated Member A profile.
# Expected: 200; displayName remains R4 Member A Updated.
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 3 — logout Member A. The explicit Cookie header is the pre-logout token.
# Expected: 204 and a clearing Set-Cookie header; no response body.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/logout HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 3 — after logout, do not send @memberAToken again.
# Expected: 401 AUTH_REQUIRED. Leave out the Cookie header.
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1

###
# Test 4 — duplicate normalized email. Prerequisite: Member A exists. If runId changes, update
# memberAEmailUpper to the exact uppercase form of memberAEmail as well.
# Expected: 409 USER_EMAIL_ALREADY_EXISTS; no new User.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "  {{memberAEmailUpper}}  ",
  "password": "{{testPassword}}",
  "displayName": "Duplicate Attempt"
}

###
# Test 5 — wrong password. Prerequisite: Member A is active.
# Expected: 401 AUTH_INVALID_CREDENTIALS; no valid login cookie.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}",
  "password": "wrong local password"
}

###
# Test 5a — unknown email login. Prerequisite: do not register {{unknownEmail}}.
# Expected: 401 AUTH_INVALID_CREDENTIALS; no User created.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{unknownEmail}}",
  "password": "wrong local password"
}

###
# Test 6 — invalid register body.
# Expected: 400 VALIDATION_ERROR; no User created.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "short",
  "displayName": "   "
}

###
# Test 6 — login missing password.
# Expected: 400 VALIDATION_ERROR.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}"
}

###
# Test 6 — unauthenticated PATCH takes precedence over readonly-field validation.
# Expected: 401 AUTH_REQUIRED. Leave out the Cookie header.
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/users/me HTTP/1.1
Content-Type: application/json

{
  "email": "not-allowed@example.test"
}

###
# Test 6 — login setup for 6, 6a, and 6b protected PATCH requests.
# Copy only access_token's value into @memberAToken after this response.
# Expected: 200 and a Set-Cookie header.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 6 — readonly email PATCH with an explicit Member A Cookie.
# Expected: 400 VALIDATION_ERROR; error.details includes email.
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/users/me HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{
  "email": "not-allowed@example.test"
}

###
# Test 6a — blank displayName PATCH with an explicit Member A Cookie.
# Expected: 400 VALIDATION_ERROR; error.details includes displayName.
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/users/me HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{
  "displayName": "   "
}

###
# Test 6b — empty PATCH no-op with an explicit Member A Cookie.
# Prerequisite: record updated_at before/after with Markdown test 6b SQL.
# Expected: 200; current User; updated_at unchanged.
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/users/me HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{}

###
# Test 7 — invalid Token. This literal bad Cookie must be the only token sent.
# Expected: 401 AUTH_TOKEN_INVALID.
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1
Cookie: access_token=not-a-jwt

###
# Test 7a — logout without Cookie.
# Expected: 204 and a clearing Set-Cookie header; no Authentication error.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/logout HTTP/1.1

###
# Test 7b — logout with an invalid Cookie. This literal bad Cookie must be the only token sent.
# Expected: 204 and a clearing Set-Cookie header; not AUTH_TOKEN_INVALID.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/logout HTTP/1.1
Cookie: access_token=not-a-jwt

###
# Test 8 — short-lifetime API health. First start/stop the temporary API and wait as in Markdown test 8.
# Expected: 200 from {{shortApiBase}}; confirms the actual temporary listener.
# @no-cookie-jar
GET {{shortApiBase}}/health HTTP/1.1

###
# Test 8 — short-lifetime login. Copy only access_token's value into @shortToken immediately.
# Prerequisite: temporary Development API at {{shortApiBase}} has Jwt__LifetimeMinutes=1.
# Expected: 200 and a Set-Cookie header.
# @no-cookie-jar
POST {{shortApiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 8 — expired Token. Wait at least 65 seconds after the preceding login, then send @shortToken.
# Expected: 401 AUTH_TOKEN_EXPIRED. The Cookie header is explicit, so expiry cannot suppress sending it.
# @no-cookie-jar
GET {{shortApiBase}}/api/v1/users/me HTTP/1.1
Cookie: access_token={{shortToken}}

###
# Test 9 — login Member B before changing its database status.
# Then perform the Disabled status SQL operation in Markdown test 9 and copy only access_token into @memberBToken.
# Expected: 200 and a Set-Cookie header before the SQL change.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberBEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 9 — existing Member B token after SQL changes its status to disabled.
# Prerequisite: complete the Disabled status SQL in Markdown test 9 first.
# Expected: 403 AUTH_USER_DISABLED.
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1
Cookie: access_token={{memberBToken}}

###
# Test 9 — disabled Member B with correct credentials.
# Expected: 403 AUTH_USER_DISABLED.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberBEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 9 — disabled Member B with wrong credentials.
# Expected: 401 AUTH_INVALID_CREDENTIALS; disabled state is not disclosed.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberBEmail}}",
  "password": "wrong local password"
}

###
# Test 10 — Member A login for Cookie flag inspection. Copying the token is unnecessary for this request.
# Expected: 200; Set-Cookie includes HttpOnly, SameSite=Lax, Path=/, Expires; no Domain, Max-Age, or Secure.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 10 — logout Cookie flag inspection without a valid Token replay.
# Expected: 204; clearing Set-Cookie uses the same scope and has no body.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/logout HTTP/1.1

###
# Test 11 — CORS header smoke test for the configured credentialed origin.
# Expected: 204; Allow-Origin={{allowedOrigin}} and Allow-Credentials=true.
# @no-cookie-jar
OPTIONS {{apiBase}}/api/v1/auth/login HTTP/1.1
Origin: {{allowedOrigin}}
Access-Control-Request-Method: POST

###
# Test 11 — CORS header smoke test for an unconfigured origin.
# Expected: no Access-Control-Allow-Origin or Access-Control-Allow-Credentials; never wildcard Allow-Origin.
# @no-cookie-jar
OPTIONS {{apiBase}}/api/v1/auth/login HTTP/1.1
Origin: http://localhost:3001
Access-Control-Request-Method: POST

# Test 12 is SQL-only. Perform its hash/non-plaintext and users-column checks in the Markdown plan;
# it deliberately has no HTTP request here.

###
# Test 13 — after restoring Member B to active with the Markdown SQL, re-login Member A.
# Copy only access_token's value into @memberAToken.
# Expected: 200 and a Set-Cookie header.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 13 — final Member A current-user check.
# Expected: 200 and email {{memberAEmail}}.
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 13 — re-login restored Member B. Copy only access_token's value into @memberBToken.
# Expected: 200 and a Set-Cookie header.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberBEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 13 — final Member B current-user check.
# Expected: 200 and email {{memberBEmail}}.
# @no-cookie-jar
GET {{apiBase}}/api/v1/users/me HTTP/1.1
Cookie: access_token={{memberBToken}}

###
# Test 13 — standard API health after all temporary API work has stopped.
# Expected: 200 and {"status":"healthy"}.
# @no-cookie-jar
GET {{apiBase}}/health HTTP/1.1

###
# Test 13 — standard PostgreSQL readiness after cleanup.
# Expected: 200 and Healthy.
# @no-cookie-jar
GET {{apiBase}}/health/ready HTTP/1.1
