@qMultiple = PASTE_MULTIPLE_ID_FROM_03a
@qRating = PASTE_RATING_ID_FROM_03a
@qRemove = PASTE_REMOVE_QUESTION_ID_FROM_03a
@oAlpha = PASTE_ALPHA_ID_FROM_03a
@oBeta = PASTE_BETA_ID_FROM_03a
@oDelete = PASTE_GAMMA_ID_FROM_03a
@oKeep = PASTE_DELTA_ID_FROM_03a
@oOther = PASTE_OTHER_PARENT_OPTION_ID_FROM_03a
@qForeign = PASTE_FOREIGN_QUESTION_ID_FROM_03b
@oForeign = PASTE_FOREIGN_OPTION_ID_FROM_03b
@qConcurrentA = PASTE_FIRST_QUESTION_ID_FROM_03c
@qConcurrentB = PASTE_SECOND_QUESTION_ID_FROM_03c
@qNew = PASTE_ADDED_CHOICE_ID_FROM_05a
@oNew = PASTE_NEW_CHILD_ID_FROM_05a

