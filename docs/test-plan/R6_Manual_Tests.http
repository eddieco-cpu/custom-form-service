###
# R6-05a — 200；仍 6 Questions／6 Options。qRemove 與 cascade 子 Option 實體刪除；qText description=null／required=true；oAlpha=beta/order1、oBeta=alpha/order0，ID／createdAt 保留；新 gamma trim，ID 與 oDelete 不同。新增 qNew／oNew（記錄 ID）；oKeep 的大小寫 Delta 保留。最終排序唯一，不因中途 key／排序衝突回 500。
# Prerequisite: complete preceding cases and Markdown R6-05 operations.
# Identity: Member A (Owner).
# Actual AI/manual result: 待執行（等待 Owner review）。
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/forms/{{editorFormId}} HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{
  "questions": [
    {
      "id": "{{qText}}",
      "description": null,
      "title": "  Text edited  ",
      "required": true
    },
    {
      "id": "{{qChoice}}",
      "options": [
        {
          "id": "{{oAlpha}}",
          "value": " beta ",
          "sortOrder": 1,
          "label": "  Now beta  "
        },
        {
          "id": "{{oBeta}}",
          "value": "alpha",
          "sortOrder": 0
        },
        {
          "id": "{{oDelete}}"
        },
        {
          "label": "  Reused gamma  ",
          "value": " gamma ",
          "sortOrder": 2
        }
      ]
    },
    {
      "id": "{{qRemove}}"
    },
    {
      "type": "single_choice",
      "title": "Added choice",
      "sortOrder": 50,
      "config": {
        "variant": "radio"
      },
      "options": [
        {
          "label": "New child",
          "value": "new",
          "sortOrder": 0
        }
      ]
    }
  ]
}

