###
# R6-03a — 201 Draft；6 Questions／6 Options；placeholder trim；Rating 缺 max 仍合法。按 sortOrder 排序，defaults、ID 與 createdAt 由 Server 決定。
# Prerequisite: complete preceding cases and Markdown R6-03 operations.
# Identity: Member A (Owner).
# Actual AI/manual result: 待執行（等待 Owner review）。
# @no-cookie-jar
POST {{apiBase}}/api/v1/forms HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{
  "title": "R6 editor {{runId}}",
  "description": "Initial form description",
  "questions": [
    {
      "type": "text",
      "title": "Text",
      "description": "Initial question description",
      "sortOrder": 0,
      "config": {
        "variant": "textarea",
        "placeholder": "  Enter text  ",
        "minLength": 0,
        "maxLength": 20
      }
    },
    {
      "type": "number",
      "title": "Number",
      "sortOrder": 10,
      "config": {
        "placeholder": "  Amount  ",
        "min": -1,
        "max": 10
      }
    },
    {
      "type": "single_choice",
      "title": "Choice",
      "sortOrder": 20,
      "config": {
        "variant": "select"
      },
      "options": [
        {
          "label": "Alpha",
          "value": "alpha",
          "sortOrder": 0
        },
        {
          "label": "Beta",
          "value": "beta",
          "sortOrder": 1
        },
        {
          "label": "Delete gamma",
          "value": "gamma",
          "sortOrder": 2
        },
        {
          "label": "Untouched Delta",
          "value": "Delta",
          "sortOrder": 3
        }
      ]
    },
    {
      "type": "multiple_choice",
      "title": "Multiple",
      "sortOrder": 30,
      "config": {
        "variant": "checkbox"
      },
      "options": [
        {
          "label": "Other parent",
          "value": "other",
          "sortOrder": 0
        }
      ]
    },
    {
      "type": "rating",
      "title": "Incomplete rating",
      "sortOrder": 40,
      "config": {
        "min": 0
      }
    },
    {
      "type": "single_choice",
      "title": "Remove question",
      "sortOrder": 50,
      "options": [
        {
          "label": "Cascade child",
          "value": "cascade",
          "sortOrder": 0
        }
      ]
    }
  ]
}

