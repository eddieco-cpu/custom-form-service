# R7 paired plan: Prepare / pending Owner review; do not execute before approval and authorization.
# Companion: R7_Acceptance_Test.md owns startup, regression, snapshots, probes, concurrency and cleanup.
# Implementation baseline db2fe1b. No R8/G1; all AI/manual results pending.
# Retain R4/R5/R6 and new fixtures. Fresh RunId per independent run; no fixture resets.
# Obtain password locally; copy access_token VALUE only, never the full Set-Cookie header.
# REST Client: Clear All Cookies, and keep @no-cookie-jar on every request.
# R7-14a/14b are PARALLEL TEMPLATES; send only inside the Markdown barrier harness.

@apiBase = http://localhost:5000
@runId = r7-acceptance-20261004-01
@testPassword = ENTER_RETAINED_R4_PASSWORD_LOCALLY
@memberAEmail = r4-member-a-r4-acceptance-20261001-01@example.test
@memberBEmail = r4-member-b-r4-acceptance-20261001-01@example.test
@memberAToken = PASTE_ACCESS_TOKEN_VALUE_ONLY
@memberBToken = PASTE_ACCESS_TOKEN_VALUE_ONLY
@futureDeadline = 2036-10-04T00:00:00.123456Z
@missingFormId = 00000000-0000-0000-0000-000000000007
@mainFormId = PASTE_FORM_ID_FROM_04a
@deletedFormId = PASTE_FORM_ID_FROM_04b
@concurrentFormId = PASTE_FORM_ID_FROM_04c
@qMainText = PASTE_SORT_0_QUESTION_ID_FROM_04a
@qMainSingle = PASTE_SORT_2_QUESTION_ID_FROM_04a
@qMainRating = PASTE_SORT_4_QUESTION_ID_FROM_04a
@oMainSingle = PASTE_NEW_SINGLE_OPTION_ID_FROM_07a
@qConcurrentRating = PASTE_SORT_0_QUESTION_ID_FROM_04c

