###
# R7-04a — 201 Draft；5 Questions／1 Option，Choice 空／Rating {} 可存；記 mainFormId／子 IDs
# Prerequisite: preceding cases plus Markdown R7-04; identity: A.
# AI actual: 未執行（等待 Owner review）; manual actual: 未執行（等待 Owner review）.
# @no-cookie-jar
POST {{apiBase}}/api/v1/forms HTTP/1.1
Cookie: access_token={{memberAToken}}
Content-Type: application/json

{
  "title": "R7 main {{runId}}",
  "submissionDeadlineAt": "{{futureDeadline}}",
  "questions": [
    {
      "type": "text",
      "title": "Text",
      "sortOrder": 0,
      "config": {
        "placeholder": "x"
      }
    },
    {
      "type": "number",
      "title": "Number",
      "sortOrder": 1,
      "config": {
        "min": 1000000000000000000000000000000,
        "max": 10000000000000000000000000000000
      }
    },
    {
      "type": "single_choice",
      "title": "Single",
      "sortOrder": 2,
      "options": []
    },
    {
      "type": "multiple_choice",
      "title": "Multiple",
      "sortOrder": 3,
      "options": [
        {
          "label": "Other",
          "value": "other",
          "sortOrder": 0
        }
      ]
    },
    {
      "type": "rating",
      "title": "Rating",
      "sortOrder": 4,
      "required": false,
      "config": {}
    }
  ]
}

