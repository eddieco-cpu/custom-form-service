# R0～R9 整合回歸驗收 — Prepare（2026-10-07）
# 狀態：整體 review 完成；整合驗收計畫待 Owner review，尚未執行。
# Companion: R0_R9_Integration_Acceptance_Test.md；review 基準 6f61a160863bfacb2fd85ef3d97abca271af5e22
# 72 HTTP requests＋01／02／10／15／17 非 HTTP；保留既有與本次合成資料。
# R10 Statistics、G1 Google Auth、R11／前端／部署不納入。
# 所有預期以正式規格為準；12a～d 受 review 缺陷影響，先由 Owner 決定修正／執行順序。
# 先 Clear All Cookies；每個 request @no-cookie-jar，只用明確 Cookie；none 身分不送 Cookie。
# 工作副本在忽略的本次RunDir；不要把密碼／Token／Set-Cookie存進版本控制或證據。
# 登出16a後清除本機aToken；16b不帶Cookie。JWT本身未撤銷。
# AI／人工分開記錄。以下全部尚未執行；現有測試PASS不可代填。

@apiBase = http://localhost:5000
@runId = <NEW_UNIQUE_RUN_ID_AFTER_APPROVAL>
@aEmail = ir-a-{{runId}}@example.test
@bEmail = ir-b-{{runId}}@example.test
@testPassword = <GENERATE_10_TO_128_CODE_POINT_PASSWORD_LOCALLY>
@wrongPassword = <DIFFERENT_NONEMPTY_PASSWORD_LOCALLY>
@aId = <COPY_03a_USER_ID>
@bId = <COPY_03b_USER_ID>
@aToken = <COPY_03f_ACCESS_TOKEN_VALUE_LOCALLY>
@bToken = <COPY_03g_ACCESS_TOKEN_VALUE_LOCALLY>
@futureDeadline = <UTC_ISO8601_Z_AT_LEAST_24_HOURS_AFTER_EXECUTION>
@mId = <COPY_04a_ID>
@sId = <COPY_04b_ID>
@fId = <COPY_04c_ID>
@qS = <COPY_04b_OPTIONAL_TEXT_ID>
@qForeign = <COPY_04c_TEXT_ID>
@qText = <COPY_06b_Text_ID>
@qNumber = <COPY_06b_Number_ID>
@qRating = <COPY_06b_Rating_ID>
@qSingle = <COPY_06b_Single_ID>
@qMultiple = <COPY_06b_Multiple_ID>
@qTemp = <COPY_06b_Temporary_ID>
@sc1 = <COPY_06b_Single_OPTION_VALUE_one_ID>
@sc2 = <COPY_06b_Single_OPTION_VALUE_two_ID>
@mc1 = <COPY_06b_Multiple_OPTION_VALUE_a_ID>
@mc2 = <COPY_06b_Multiple_OPTION_VALUE_b_ID>
@temp1 = <COPY_06b_Temporary_OPTION_VALUE_temp1_ID>
@temp2 = <COPY_06b_Temporary_OPTION_VALUE_temp2_ID>
@bR1 = <COPY_08c_RESPONSE_ID>
@bR2 = <COPY_08d_RESPONSE_ID>
@aR1 = <COPY_08f_RESPONSE_ID>
@sBR = <COPY_09b_RESPONSE_ID>

