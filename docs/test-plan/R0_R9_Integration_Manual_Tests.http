### 06b — 完整新增 Definition
# 前置：前一案例成功或預期拒絕已確認；身分：A
# 預期：200；multiple／identified；6 Questions／6 Options；按題 title 取得 qText/qNumber/qRating/qSingle/qMultiple/qTemp 與選項 IDs；至少 Text required=true
# DB／非HTTP核對：按Markdown 06與§5；保留既有資料與本次fixtures。
# AI實際：未執行（等待 Owner review）
# 人工實際：未執行（等待 Owner review）
# @no-cookie-jar
PATCH {{apiBase}}/api/v1/forms/{{mId}}
Cookie: access_token={{aToken}}
Content-Type: application/json

{"responseMode":"multiple","responseIdentity":"identified","questions":[{"type":"text","title":"Text","required":true,"sortOrder":10,"config":{"minLength":2,"maxLength":100}},{"type":"number","title":"Number","sortOrder":20,"config":{"min":0,"max":100}},{"type":"rating","title":"Rating","sortOrder":30,"config":{"min":1,"max":5}},{"type":"single_choice","title":"Single","sortOrder":40,"options":[{"label":"One","value":"one","sortOrder":0},{"label":"Two","value":"two","sortOrder":10}]},{"type":"multiple_choice","title":"Multiple","sortOrder":50,"options":[{"label":"A","value":"a","sortOrder":0},{"label":"B","value":"b","sortOrder":10}]},{"type":"single_choice","title":"Temporary","sortOrder":60,"options":[{"label":"Temp 1","value":"temp1","sortOrder":0},{"label":"Temp 2","value":"temp2","sortOrder":10}]}]}

### 06c — 排序交換與 config replacement
# 前置：前一案例成功或預期拒絕已確認；身分：A
