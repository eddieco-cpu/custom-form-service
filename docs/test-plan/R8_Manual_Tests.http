### 04a — 建立 main single／五題型
# 前置：Markdown 04；此前依賴成功；按檔案順序。
# 預期：201 Draft FormDetail；5 Questions／3 Options
# 保存 mainFormId；以 type／sortOrder 配對 qMainText／Number／Single／Multiple／Rating、oMainSingle、oMainMultipleOne／Two；記完整 Definition snapshot。
# AI 實際：未執行（等待 Owner review）
# 人工實際：未執行（等待 Owner review）
# @no-cookie-jar
POST {{apiBase}}/api/v1/forms
Cookie: access_token={{memberAToken}}
Content-Type: application/json

{
  "title": "R8 main {{runId}}",
  "responseMode": "single",
  "responseIdentity": "anonymous",
  "questions": [
    {
      "type": "text",
      "title": "Required text",
      "required": true,
      "sortOrder": 0,
      "config": {
        "minLength": 2,
        "maxLength": 100
      }
    },
    {
      "type": "number",
      "title": "Exact number",
      "sortOrder": 1,
      "config": {
        "min": 0,
        "max": 1e+30
      }
    },
    {
      "type": "single_choice",
      "title": "Single",
      "sortOrder": 2,
      "options": [
        {
          "label": "One",
          "value": "one",
          "sortOrder": 0
        }
      ]
    },
    {
      "type": "multiple_choice",
      "title": "Multiple",
      "sortOrder": 3,
      "options": [
        {
          "label": "One",
          "value": "one",
          "sortOrder": 0
        },
        {
          "label": "Two",
          "value": "two",
          "sortOrder": 1
        }
      ]
    },
    {
      "type": "rating",
      "title": "Rating",
      "sortOrder": 4,
      "config": {
        "min": 1,
        "max": 5
      }
    }
  ]
}

