Cookie: access_token={{memberAToken}}
Content-Type: application/json

{"title":"R9 main {{runId}}","responseMode":"multiple","responseIdentity":"anonymous","resultVisibility":"owner_only","submissionDeadlineAt":"{{futureDeadline}}","questions":[{"type":"text","title":"Text","sortOrder":20},{"type":"number","title":"Number","sortOrder":10}]}

