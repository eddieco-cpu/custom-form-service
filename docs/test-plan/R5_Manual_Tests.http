# R5 manual requests for the VS Code REST Client extension.
# This file is the sequential HTTP companion to R5_Acceptance_Test.md. The Markdown plan
# remains the authority for Docker, API startup, database checks, actual-result recording,
# and cleanup. Do not run any request until the owner has approved both R5 test files.
#
# Before a run, complete Markdown test 1: Compose PostgreSQL, build/start the standard API,
# log in the retained R4 synthetic members, and record Member A's all-Form and Draft-Form
# baseline totals/IDs. Use one fixed runId for every request below.
# If this acceptance is repeated, change runId and the matching title values together in both
# R5 files. Keep the R4 members and the created R5 Forms after the run.
#
# Cookie handling: first run "Rest Client: Clear All Cookies". Every request has
# @no-cookie-jar. After each Member A or Member B login, copy only the value after
# "access_token=" and before its first semicolon into the matching token variable. Do not
# copy a complete Set-Cookie header or attributes into a Cookie header.

@apiBase = http://localhost:5000
@runId = r5-acceptance-20261002-01
@testPassword = R4 local password r4-acceptance-20261001-01!
@memberAEmail = r4-member-a-r4-acceptance-20261001-01@example.test
@memberBEmail = r4-member-b-r4-acceptance-20261001-01@example.test
@nestedTitle = R5 nested draft {{runId}}
@atomicFailureTitle = R5 atomic failure {{runId}}
@deleteTitle = R5 soft delete {{runId}}
@memberAToken = PASTE_ACCESS_TOKEN_VALUE_ONLY
@memberBToken = PASTE_ACCESS_TOKEN_VALUE_ONLY
@nestedFormId = PASTE_NESTED_FORM_ID_FROM_TEST_2
@deleteFormId = PASTE_DELETE_FORM_ID_FROM_TEST_4
@baselineListPage = 1
@baselinePageSize = 100
@pageAfterCreates = PASTE_BASELINE_TOTAL_PLUS_3_FROM_MARKDOWN_TEST_4

###
# Test 1 — API health. Prerequisite: complete Markdown test 1 startup/readiness operations.
# Expected: 200 and {"status":"healthy"}. Run the Compose and DB readiness checks in Markdown.
# @no-cookie-jar
GET {{apiBase}}/health HTTP/1.1

###
# Test 1 — API database readiness. Prerequisite: Compose postgres is healthy.
# Expected: 200 and Healthy. The Docker/DB operations remain in Markdown test 1.
# @no-cookie-jar
GET {{apiBase}}/health/ready HTTP/1.1

###
# Test 1 — Login retained Member A. Copy only access_token's value into @memberAToken.
# Expected: 200, public User body, and Set-Cookie; no token in the JSON body.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberAEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 1 — Login retained Member B. Copy only access_token's value into @memberBToken.
# Expected: 200, public User body, and Set-Cookie.
# @no-cookie-jar
POST {{apiBase}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{memberBEmail}}",
  "password": "{{testPassword}}"
}

###
# Test 1 — Record Member A's all-Form baseline. Prerequisite: Member A login token is set.
# Necessary operation: record totalItems and every returned id; if totalPages is greater than 1,
# increment @baselineListPage and rerun this request until all pages/IDs are recorded. This is
# read-only. Expected: 200, only Member A's current non-deleted Forms, no data changes.
# The full baseline comparison and actual-result record remain in Markdown test 1.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms?page={{baselineListPage}}&pageSize={{baselinePageSize}} HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 1 — Record Member A's Draft-Form baseline. Prerequisite: all-Form baseline recorded.
# Necessary operation: repeat pages as above and record totalItems/every id for status=draft.
# Expected: 200, only Member A's current non-deleted Draft Forms, no data changes. The full
# baseline comparison and actual-result record remain in Markdown test 1.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms?page={{baselineListPage}}&pageSize={{baselinePageSize}}&status=draft HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 2 — Create Member A's nested Draft Form. After 201, copy its response id field into
# @nestedFormId. Run the nested response and DB row-count checks in Markdown test 2.
# Expected: 201 FormDetail; trimmed title/descriptions, Draft defaults, two Questions sorted
# Rating (sortOrder 2) then Single Choice (sortOrder 4), and options First then Second.
# @no-cookie-jar
POST {{apiBase}}/api/v1/forms HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{
  "title": "  {{nestedTitle}}  ",
  "description": " \u2003 ",
  "questions": [
    {
      "type": "single_choice",
      "title": "  Select one  ",
      "description": " \u2003 ",
      "required": true,
      "sortOrder": 4,
      "config": { "variant": "radio" },
      "options": [
        { "label": " Second ", "value": "second", "sortOrder": 1 },
        { "label": " First ", "value": "first", "sortOrder": 0 }
      ]
    },
    {
      "type": "rating",
      "title": "Rate this draft",
      "sortOrder": 2,
      "config": { "min": 1 }
    }
  ]
}

###
# Test 3 — Nested definition failure. Prerequisite: Test 2 completed; this request must not
# change @nestedFormId. Run the no-partial-write DB query in Markdown test 3.
# Expected: 400 FORM_DEFINITION_INVALID; details identify the second duplicate option value.
# @no-cookie-jar
POST {{apiBase}}/api/v1/forms HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{
  "title": "{{atomicFailureTitle}}",
  "questions": [
    {
      "type": "single_choice",
      "title": "Duplicate values",
      "sortOrder": 0,
      "options": [
        { "label": "One", "value": "duplicate", "sortOrder": 0 },
        { "label": "Two", "value": "duplicate", "sortOrder": 1 }
      ]
    }
  ]
}

###
# Test 4 — Create the Form to be soft-deleted. Copy its response id field into @deleteFormId.
# Prerequisite: Test 2 succeeded; wait briefly as Markdown test 4 specifies before this request.
# Expected: 201 Draft FormDetail with one Question and one Option.
# @no-cookie-jar
POST {{apiBase}}/api/v1/forms HTTP/1.1
Content-Type: application/json
Cookie: access_token={{memberAToken}}

{
  "title": "{{deleteTitle}}",
  "questions": [
    {
      "type": "single_choice",
      "title": "Keep definition after delete",
      "sortOrder": 0,
      "options": [
        { "label": "Only option", "value": "only", "sortOrder": 0 }
      ]
    }
  ]
}

###
# Test 4 — Member A list, first page. Prerequisite: copy @deleteFormId from preceding 201
# and complete the baseline-aware complete-list check in Markdown test 4.
# Expected: 200; page=1/pageSize=1 item matches the first item in the complete sorted List.
# totalItems and totalPages equal Member A's all-Form baseline + 2; do not expect a fixed title
# or count because retained Forms may exist. The complete ID/order checks remain in Markdown.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms?page=1&pageSize=1 HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 4 — Member A list beyond the last page. Prerequisite: set @pageAfterCreates to the
# value calculated in Markdown test 4 (Member A all-Form baseline total + 3).
# Expected: 200; items=[] and pagination.page retains @pageAfterCreates. See Markdown test 4.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms?page={{pageAfterCreates}}&pageSize=1 HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 4 — Member A Draft-status filter. Prerequisite: complete the Markdown total/ID check.
# Expected: 200; Draft total is the Draft baseline + 2 and includes @nestedFormId/@deleteFormId.
# Retained Draft Forms may also appear; compare all IDs and sort order in Markdown test 4.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms?status=draft HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 4 — Member B Owner-only list boundary.
# Expected: 200; its items do not contain @nestedFormId or @deleteFormId.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms HTTP/1.1
Cookie: access_token={{memberBToken}}

###
# Test 4 — Invalid page query.
# Expected: 400 VALIDATION_ERROR.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms?page=0 HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 5 — Owner reads its own Draft. Prerequisite: @nestedFormId was copied from Test 2.
# Expected: 200 FormDetail.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms/{{nestedFormId}} HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 5 — Member B cannot discover Member A's Draft.
# Expected: 404 FORM_NOT_FOUND, not FORM_ACCESS_DENIED.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms/{{nestedFormId}} HTTP/1.1
Cookie: access_token={{memberBToken}}

###
# Test 5 — Member B cannot delete Member A's Draft.
# Expected: 403 FORM_ACCESS_DENIED; neither Form nor definition data changes.
# @no-cookie-jar
DELETE {{apiBase}}/api/v1/forms/{{nestedFormId}} HTTP/1.1
Cookie: access_token={{memberBToken}}

###
# Test 5 — Missing credentials take precedence over invalid formId parsing.
# Expected: 401 AUTH_REQUIRED. Leave out the Cookie header.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms/not-a-uuid HTTP/1.1

###
# Test 5 — Valid Member A credentials expose invalid formId validation.
# Expected: 400 VALIDATION_ERROR.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms/not-a-uuid HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 6 — Owner soft-deletes the designated Form. Prerequisite: @deleteFormId was copied
# from Test 4. Run the retained Question/Option DB checks in Markdown test 6 after this request.
# Expected: 204 No Content.
# @no-cookie-jar
DELETE {{apiBase}}/api/v1/forms/{{deleteFormId}} HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 6 — Repeating the same delete hides the already deleted Form.
# Expected: 404 FORM_NOT_FOUND.
# @no-cookie-jar
DELETE {{apiBase}}/api/v1/forms/{{deleteFormId}} HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 6 — Owner Detail after Soft Delete.
# Expected: 404 FORM_NOT_FOUND.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms/{{deleteFormId}} HTTP/1.1
Cookie: access_token={{memberAToken}}

###
# Test 6 — Member B Detail after Soft Delete.
# Expected: 404 FORM_NOT_FOUND.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms/{{deleteFormId}} HTTP/1.1
Cookie: access_token={{memberBToken}}

###
# Test 6 — Owner's Draft list excludes the deleted Form. Prerequisite: complete the baseline-
# aware all-Form and Draft-Form checks in Markdown test 6 after the preceding DELETE.
# Expected: 200; both totals are their respective baselines + 1, includes @nestedFormId, and
# excludes @deleteFormId. Retained Forms may remain; verify complete IDs/order in Markdown.
# @no-cookie-jar
GET {{apiBase}}/api/v1/forms?status=draft HTTP/1.1
Cookie: access_token={{memberAToken}}

# Test 7 is non-HTTP. Remove temporary files and run the retained synthetic-data DB checks in
# Markdown test 7. Before saving or committing this file, restore these exact lines:
# @memberAToken = PASTE_ACCESS_TOKEN_VALUE_ONLY
# @memberBToken = PASTE_ACCESS_TOKEN_VALUE_ONLY
# Do not retain or commit a valid JWT. Do not delete R4 members, R5 Forms, PostgreSQL
# containers, volumes, or other existing Forms.
